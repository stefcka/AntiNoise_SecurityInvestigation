# Copy to .env and fill in. Never commit .env.

ANALYST_NAME=your-name

# --- Microsoft tenant (leave blank to run entirely on sample telemetry) ---
AZURE_TENANT_ID=
# Read-only collector app: Graph AuditLog.Read.All, Directory.Read.All (+ Office 365 Management APIs ActivityFeed.Read)
COLLECTOR_CLIENT_ID=
COLLECTOR_CLIENT_SECRET=
# Separate responder app: DelegatedPermissionGrant.ReadWrite.All, Application.ReadWrite.All, User.RevokeSessions.All
RESPONDER_CLIENT_ID=
RESPONDER_CLIENT_SECRET=
TENANT_DOMAINS=contoso.com

# Actions that really run. Anything not listed is SIMULATED and labelled as such.
LIVE_ACTIONS=
# LIVE_ACTIONS=REVOKE_OAUTH_GRANT,DISABLE_APPLICATION,REVOKE_USER_SESSIONS

# --- VM isolation (optional) ---
AZURE_SUBSCRIPTION_ID=
ISOLATION_NSG_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Network/networkSecurityGroups/nsg-isolate-all

# --- Detection policy ---
ALLOWED_COUNTRIES=US
HIGH_VOLUME_ITEM_THRESHOLD=50

# --- AI investigator: self-hosted model (see docs/local_llm.md) ---
LLM_PROVIDER=local                 # local | anthropic | none
LOCAL_LLM_API=ollama               # ollama | openai (llama.cpp server, vLLM, LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_CONTEXT=16384            # tokens; Ollama's default is too small for the larger incidents
LOCAL_LLM_TIMEOUT=300              # seconds per call
LOCAL_LLM_API_KEY=
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0

# Only if LLM_PROVIDER=anthropic (sends incident data to a hosted API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
